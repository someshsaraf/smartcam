# Edge Pi @ 192.168.2.160 → controller / MQTT @ 192.168.2.104
# Loaded automatically by app/env_loader.py — do not run: source .env
# Start: uvicorn app.main:app --host 0.0.0.0 --port 8080

# --- Built-in RTSP publisher (MediaMTX + rpiCamera on :8554/{cam_id}) ---
SURVEILLANCE_PI_CAMERA=1
SURVEILLANCE_PUBLISHER_PORT=8554

# Controller MQTT broker (Pi 5 @ 192.168.2.104)
SURVEILLANCE_MQTT_HOST=192.168.2.104
SURVEILLANCE_MQTT_PORT=1883
SURVEILLANCE_MQTT_USER=
SURVEILLANCE_MQTT_PASSWORD=
SURVEILLANCE_MQTT_TOPIC_PREFIX=surveillance/cameras

# Identity / discovery (must match controller camera row / MediaMTX path)
SURVEILLANCE_EDGE_CAMERA_ID=camera1
SURVEILLANCE_MEDIAMTX_PATH=camera1

# Route hint for LAN IP guess + advertised RTSP URL in mDNS
SURVEILLANCE_CONTROLLER_IP=192.168.2.104
SURVEILLANCE_EDGE_IP=192.168.2.160

# HTTP API (must match uvicorn bind port)
SURVEILLANCE_EDGE_HTTP_PORT=8080

SURVEILLANCE_EDGE_DISPLAY_NAME="Vigilance Edge"
SURVEILLANCE_EDGE_LOCATION=

# Recorder input: leave unset to use loopback RTSP from LocalPublisher
SURVEILLANCE_RTSP_URL=

# Dashboard face detection (Phase 1) runs on the controller; no extra edge env vars.
