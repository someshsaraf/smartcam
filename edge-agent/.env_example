# Edge Pi @ 192.168.2.164 → controller @ 192.168.2.139
# Loaded by app/env_loader.py on uvicorn start. Do not run: source .env

# --- Built-in RTSP publisher (MediaMTX + rpiCamera) ---
SURVEILLANCE_PI_CAMERA=1
SURVEILLANCE_PUBLISHER_PORT=8554
SURVEILLANCE_MEDIAMTX_BIN=

# --- MQTT (broker on Pi 5) ---
SURVEILLANCE_MQTT_HOST=192.168.2.139
SURVEILLANCE_MQTT_PORT=1883
SURVEILLANCE_MQTT_USER=
SURVEILLANCE_MQTT_PASSWORD=
SURVEILLANCE_MQTT_TOPIC_PREFIX=surveillance/cameras

# --- Identity / discovery ---
SURVEILLANCE_EDGE_CAMERA_ID=camera1
SURVEILLANCE_MEDIAMTX_PATH=camera1
SURVEILLANCE_CONTROLLER_IP=192.168.2.139
SURVEILLANCE_EDGE_IP=192.168.2.164
SURVEILLANCE_EDGE_HTTP_PORT=8080
SURVEILLANCE_EDGE_DISPLAY_NAME="Vigilance Edge"
SURVEILLANCE_EDGE_LOCATION=

# --- Recorder input (empty = loopback RTSP from LocalPublisher when PI_CAMERA=1) ---
SURVEILLANCE_RTSP_URL=

# --- ONVIF discovery (USB/IP camera on LAN; same creds as controller SMARTCAM_EDGE_ONVIF_*) ---
# Used when SURVEILLANCE_RTSP_URL is empty and SURVEILLANCE_PI_CAMERA is not set.
# SURVEILLANCE_ONVIF_USER=admin
# SURVEILLANCE_ONVIF_PASS='your-camera-password'

SURVEILLANCE_RECORDINGS_DIR=
SURVEILLANCE_MODEL_DIR=
SURVEILLANCE_SHARED_PATH=

# --- OpenCV RTSP (optional) ---
OPENCV_FFMPEG_CAPTURE_OPTIONS=
SURVEILLANCE_OPENCV_FFMPEG_CAPTURE_OPTIONS=

# --- Controller-triggered motion clips (rolling RTSP buffer on edge) ---
EDGE_MOTION_BUFFER_SECONDS=30
EDGE_MOTION_CLOCK_SKEW_MAX_SEC=3

# --- MobileNet-SSD (optional; not used for motion clips — controller Hailo only) ---
SURVEILLANCE_SSD_PROTO=
SURVEILLANCE_SSD_WEIGHTS=
SURVEILLANCE_SSD_CONFIDENCE=0.45
SURVEILLANCE_SSD_MIN_BOX_FRACTION=0.0005
SURVEILLANCE_FRAME_DIFF_FALLBACK=0
SURVEILLANCE_FALLBACK_MIN_AREA_FRACTION=0.012
