# Copy to `.env` or export before starting uvicorn. Values match edge-agent defaults in code.
# Do not commit real secrets.

# --- Stream & recorder (Pi 4) ---
# Input RTSP for OpenCV/ffmpeg. Unset = HTTP API + mDNS still run; recorder thread not started.
SURVEILLANCE_RTSP_URL=

# --- MQTT (broker on Pi 5 controller) ---
SURVEILLANCE_MQTT_HOST=192.168.2.104
SURVEILLANCE_MQTT_PORT=1883
SURVEILLANCE_MQTT_USER=
SURVEILLANCE_MQTT_PASSWORD=
SURVEILLANCE_MQTT_TOPIC_PREFIX=surveillance/cameras

# Camera id in topics: surveillance/cameras/{id}/recording (must be unique per edge).
SURVEILLANCE_EDGE_CAMERA_ID=camera1

# Recording output directory. Omit variable entirely to use default (<edge-agent>/data/recordings).
# SURVEILLANCE_RECORDINGS_DIR=

# SSD models directory (fetch_ssd_models.sh). Default: <edge-agent>/models
# SURVEILLANCE_MODEL_DIR=

# --- HTTP API & mDNS (discovery on LAN) ---
# Must match the port uvicorn binds (e.g. --port 8080).
SURVEILLANCE_EDGE_HTTP_PORT=8080

SURVEILLANCE_EDGE_DISPLAY_NAME=Vigilance Edge
SURVEILLANCE_EDGE_LOCATION=

# MediaMTX path segment for discovery/controller. Omit to default to SURVEILLANCE_EDGE_CAMERA_ID.
# SURVEILLANCE_MEDIAMTX_PATH=camera1

# Used to pick outbound interface for advertised LAN IPv4. Default if unset: 192.168.2.104
SURVEILLANCE_CONTROLLER_IP=192.168.2.104

# Optional: force advertised IPv4 for Zeroconf (otherwise derived via route to CONTROLLER_IP).
SURVEILLANCE_EDGE_IP=

# --- Shared package path ---
# Folder containing `surveillance_shared/` when not using default layout.
SURVEILLANCE_SHARED_PATH=

# --- OpenCV RTSP (optional; built-in TCP/timeouts apply if both lines unset) ---
# OPENCV_FFMPEG_CAPTURE_OPTIONS=
# SURVEILLANCE_OPENCV_FFMPEG_CAPTURE_OPTIONS=

# --- Detector / MobileNet-SSD (optional) ---
# Defaults under SURVEILLANCE_MODEL_DIR:
#   MobileNetSSD_deploy.prototxt, mobilenet_iter_73000.caffemodel
# SURVEILLANCE_SSD_PROTO=
# SURVEILLANCE_SSD_WEIGHTS=
SURVEILLANCE_SSD_CONFIDENCE=0.45
SURVEILLANCE_SSD_MIN_BOX_FRACTION=0.0005
SURVEILLANCE_FRAME_DIFF_FALLBACK=1
SURVEILLANCE_FALLBACK_MIN_AREA_FRACTION=0.012
