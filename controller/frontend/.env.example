# Copy to `.env.local` (same folder) and adjust for your LAN. Vite reads these at dev/build time.
# Defaults in App.jsx assume API host 192.168.2.104 if vars are unset — set explicitly when differs.

# Controller FastAPI (Pi 5 or dev machine)
# VITE_API_URL=http://192.168.2.104:8000

# Central MediaMTX on the controller (started by the backend when the mediamtx binary exists).
# WebRTC HTTP reader page / iframe fallback — port 8889 by default.
# VITE_MEDIAMTX_BASE=http://192.168.2.104:8889

# HLS HTTP for live tiles (Phase 1: hls.js + canvas face boxes). Backend enables HLS on :8888 unless disabled.
# Must be reachable from the browser (same host as API unless you proxy).
# VITE_HLS_BASE=http://192.168.2.104:8888

# Optional explicit WebSockets (defaults to ws(s)://<API host>/ws/… derived from VITE_API_URL)
# VITE_WS_RECORDING_URL=ws://192.168.2.104:8000/ws/recording
# VITE_WS_DETECTIONS_URL=ws://192.168.2.104:8000/ws/detections
