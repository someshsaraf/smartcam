# Copy to .env.local and adjust for your LAN. Vite reads these at dev/build time.

# Controller FastAPI (Pi 5 or dev machine)
# VITE_API_URL=http://192.168.2.104:8000

# Central MediaMTX on the controller (started by the backend when the mediamtx binary exists).
# Default matches default API host :8889 WebRTC HTTP.
# VITE_MEDIAMTX_BASE=http://192.168.2.104:8889

# Optional explicit recording WebSocket (defaults to ws(s) derived from VITE_API_URL)
# VITE_WS_RECORDING_URL=ws://192.168.2.104:8000/ws/recording
