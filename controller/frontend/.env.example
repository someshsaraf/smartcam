# Copy to `.env` (or `.env.local`) in this folder, set your controller LAN IP, then restart Vite.
#   cp .env.example .env
#   npm run dev
#
# Vite only exposes variables prefixed with VITE_.

# Controller FastAPI (Raspberry Pi 5 or machine running uvicorn)
VITE_API_URL=http://192.168.2.104:8000

# Optional — default: same host as VITE_API_URL, ports below
# VITE_MEDIAMTX_BASE=http://192.168.2.104:8889
# VITE_HLS_BASE=http://192.168.2.104:8888

# Optional WebSockets (default: derived from VITE_API_URL)
# VITE_WS_RECORDING_URL=ws://192.168.2.104:8000/ws/recording
# VITE_WS_DETECTIONS_URL=ws://192.168.2.104:8000/ws/detections
