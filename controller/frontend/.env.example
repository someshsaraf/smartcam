# =============================================================================
# Controller UI (Vite) — copy to .env and set your Pi/controller LAN IP.
# Only variables prefixed with VITE_ are exposed to the browser.
# Restart `npm run dev` (or rebuild) after any change.
# =============================================================================

# --- Required for a typical LAN setup (replace IP with your controller host) ---
VITE_API_URL=http://192.168.2.139:8000

# --- Strongly recommended (defaults guess from hostname + ports; explicit is safer) ---
# HLS segments (MediaMTX :8888). Must match where the browser can reach HLS.
VITE_HLS_BASE=http://192.168.2.139:8888
# WebRTC reader iframe (MediaMTX :8889). Only used when VITE_LIVE_WEBRTC=1.
VITE_MEDIAMTX_BASE=http://192.168.2.139:8889
# WebSocket URLs (default is derived from VITE_API_URL if unset).
VITE_WS_RECORDING_URL=ws://192.168.2.139:8000/ws/recording
VITE_WS_DETECTIONS_URL=ws://192.168.2.139:8000/ws/detections

# --- Live transport ---
# 0 = HLS (phones, reliable). 1 = WebRTC iframe on VITE_MEDIAMTX_BASE (low latency desktop).
VITE_LIVE_WEBRTC=0

# --- Optional: detection overlay tuning ---
VITE_DETECTION_OVERLAY_SYNC=1
VITE_DETECTION_OVERLAY_DELAY_MS=0

# --- Optional: stream debug panel on live tiles (default visible when healthy) ---
# VITE_HIDE_STREAM_DEBUG=1
# Legacy: VITE_SHOW_STREAM_DEBUG=0 hides the same as VITE_HIDE_STREAM_DEBUG=1
