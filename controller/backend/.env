# Controller Pi @ 192.168.2.139 — loaded by app/env_loader.py on uvicorn start
# Edit LAN IP below for your network. Do not run: source .env

# --- MQTT broker + bridge (managed mosquitto starts on CONTROLLER_MQTT_HOST) ---
CONTROLLER_MQTT_HOST=192.168.2.139
CONTROLLER_MQTT_PORT=1883
CONTROLLER_MQTT_USER=
CONTROLLER_MQTT_PASSWORD=
CONTROLLER_MQTT_TOPIC_PREFIX=surveillance/cameras
CONTROLLER_MOSQUITTO_DISABLED=0
CONTROLLER_MOSQUITTO_USE_SYSTEM=0

# --- Embedded MediaMTX (WebRTC :8889 + HLS :8888) ---
CONTROLLER_MEDIAMTX_DISABLED=0
CONTROLLER_MEDIAMTX_BIN=
CONTROLLER_MEDIAMTX_WEBRTC_ADDRESS=:8889
CONTROLLER_MEDIAMTX_HLS_ADDRESS=:8888
CONTROLLER_MEDIAMTX_HLS_DISABLED=0

# --- Phase 1: live face detection → WebSocket /ws/detections ---
SMARTCAM_LIVE_DETECTION_DISABLED=0
# Person detection: Hailo YOLOv8n only (models/yolov8n.hef on Pi 5 + AI HAT)
SMARTCAM_FACE_BACKEND=hailo_person_face
SMARTCAM_FACE_DETECT_INTERVAL_FRAMES=2
SMARTCAM_FACE_WS_MIN_INTERVAL_SEC=0.12
# Keep person/boxes visible this long after a single missed frame (reduces flicker)
SMARTCAM_PERSON_HOLD_SEC=3.0
# Consecutive person frames before edge clip trigger (reduces false positives)
SMARTCAM_PERSON_TRIGGER_MIN_FRAMES=3
# RTSP inference delay (ms). Use 0 with WebRTC live view; raise only if overlays are synced to HLS.
SMARTCAM_DETECTION_OVERLAY_DELAY_MS=0
# Reject huge ceiling/wall false positives (fraction of frame area)
SMARTCAM_PERSON_MAX_BOX_AREA=0.42
# Hailo postprocess row order: yxyx = baseline (ymin,xmin,ymax,xmax). Use xyxy only if boxes still wrong.
SMARTCAM_HAILO_COORD_ORDER=yxyx
# 0 = stretch-to-640 baseline (working). 1 = letterbox (experimental; needs yxyx + unmap).
SMARTCAM_HAILO_LETTERBOX=0
SMARTCAM_LIVE_DETECTION_MAX_CAMERAS=6
SMARTCAM_FACE_HAAR_SCALE=1.05
SMARTCAM_FACE_HAAR_MIN_NEIGHBORS=4
CONTROLLER_INFERENCE_RTSP_HOST=127.0.0.1
CONTROLLER_INFERENCE_RTSP_PORT=8554

# --- Hailo YOLOv8n person + face-over-person filtering ---
# Copy your compiled HEF here: controller/backend/models/yolov8n.hef
SMARTCAM_HAILO_HEF_PATH=models/yolov8n.hef
# Optional: set if Device.scan() is empty but hailortcli identify shows a device (e.g. 0001:01:00.0)
# SMARTCAM_HAILO_DEVICE_ID=0001:01:00.0
SMARTCAM_HAILO_INPUT_SIZE=640
# Display overlay (lower for low light / profile); recording uses RECORD_CONFIDENCE below
SMARTCAM_PERSON_DISPLAY_CONFIDENCE=0.62
SMARTCAM_PERSON_RECORD_CONFIDENCE=0.82
# CLAHE before Hailo inference (helps dark rooms)
SMARTCAM_LOW_LIGHT_BOOST=1
# Brief flicker hold after a miss (uses lower threshold than display)
SMARTCAM_PERSON_HOLD_CONFIDENCE=0.50
# Shape filters (thin vertical objects, tiny blobs)
SMARTCAM_PERSON_MAX_ASPECT=2.5
SMARTCAM_PERSON_MIN_BOX_WIDTH=0.06
SMARTCAM_PERSON_MIN_BOX_HEIGHT=0.09
SMARTCAM_PERSON_MIN_BOX_AREA=0.012
SMARTCAM_PERSON_NMS_IOU=0.45
SMARTCAM_PERSON_MIN_BOX_PX=24
SMARTCAM_PERSON_MAX_DETECTIONS=24
SMARTCAM_SHOW_PERSON_BOXES=1
# Face boxes disabled (OpenCV Haar was inaccurate). Person-only overlays.
SMARTCAM_HAILO_FACE_SECOND_STAGE=none
# Person detection does not fall back to OpenCV SSD (Hailo yolov8n.hef only).
# SMARTCAM_HAILO_FALLBACK_SSD=0
SMARTCAM_FACE_MIN_BOX_PX=32
SMARTCAM_FACE_MAX_PER_PERSON=3
SMARTCAM_FACE_MIN_ASPECT=0.70
SMARTCAM_FACE_MAX_ASPECT=1.45


# --- Detector models (default: backend/models) ---
SURVEILLANCE_MODEL_DIR=

# --- OpenCV RTSP (optional) ---
OPENCV_FFMPEG_CAPTURE_OPTIONS=
