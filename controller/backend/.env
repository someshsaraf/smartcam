# Controller Pi @ 192.168.2.104 (MQTT broker + FastAPI)
# Loaded automatically by app/env_loader.py — do not run: source .env
# Start: uvicorn app.main:app --host 0.0.0.0 --port 8000

# MQTT bridge subscribes here (Mosquitto should listen on this host)
CONTROLLER_MQTT_HOST=192.168.2.104
CONTROLLER_MQTT_PORT=1883
CONTROLLER_MQTT_USER=
CONTROLLER_MQTT_PASSWORD=
CONTROLLER_MQTT_TOPIC_PREFIX=surveillance/cameras

# --- Embedded MediaMTX (WebRTC :8889 + HLS :8888 for Phase 1 video tiles) ---
# Requires mediamtx binary (backend/bin/mediamtx or PATH). Off: CONTROLLER_MEDIAMTX_DISABLED=1
# CONTROLLER_MEDIAMTX_BIN=
# CONTROLLER_MEDIAMTX_WEBRTC_ADDRESS=:8889
# CONTROLLER_MEDIAMTX_HLS_ADDRESS=:8888
# If MediaMTX rejects HLS keys on your build: CONTROLLER_MEDIAMTX_HLS_DISABLED=1

# --- Phase 1: live face boxes (OpenCV Haar now; Hailo placeholder via SMARTCAM_FACE_BACKEND) ---
# SMARTCAM_LIVE_DETECTION_DISABLED=0
# SMARTCAM_FACE_BACKEND=opencv
# SMARTCAM_FACE_DETECT_INTERVAL_FRAMES=5
# SMARTCAM_FACE_WS_MIN_INTERVAL_SEC=0.12
# SMARTCAM_LIVE_DETECTION_MAX_CAMERAS=6
# SMARTCAM_FACE_HAAR_SCALE=1.05
# SMARTCAM_FACE_HAAR_MIN_NEIGHBORS=4
# Pull RTSP via localhost relay (matches embedded MediaMTX paths)
# CONTROLLER_INFERENCE_RTSP_HOST=127.0.0.1
# CONTROLLER_INFERENCE_RTSP_PORT=8554
