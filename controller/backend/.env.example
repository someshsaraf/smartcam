# =============================================================================
# Controller API (FastAPI / uvicorn) — optional file: backend/.env
# Loaded by camera_store (python-dotenv) when present; you can also export in shell.
# =============================================================================

# --- Camera registry (pick one primary approach) ---
# Persist cameras across restarts (absolute path recommended on the Pi).
# SMARTCAM_CAMERAS_JSON=/home/pi/smartcam/controller/backend/data/cameras.json

# Or bootstrap a single VIGI from env (password required for RTSP).
# Quote the password if it contains $ # : @ (dotenv + RTSP safety):
# SMARTCAM_VIGI_IP=192.168.2.42
# SMARTCAM_VIGI_USER=admin
# SMARTCAM_VIGI_PASS='your-camera-password'
# SMARTCAM_VIGI_NAME=Garage
# Resolve stream path via ONVIF when set (default on); set SMARTCAM_VIGI_ONVIF=0 for /stream1 only.
# When cameras.json exists, matching IP/host still gets these creds on API start.

# --- HLS redirect (when browser hits API on a different host than MediaMTX HLS) ---
# SMARTCAM_HLS_ORIGIN=http://192.168.2.139:8888
# SMARTCAM_HLS_PORT=8888

# --- MediaMTX YAML generation (start.sh / generate_controller_mediamtx_yaml.py) ---
# tcp (default) or automatic
# SMARTCAM_MEDIAMTX_RTSP_TRANSPORT=tcp
# After camera save, API regenerates YAML and POSTs path to MediaMTX control API (localhost).
# SMARTCAM_MEDIAMTX_API=http://127.0.0.1:9997
# SMARTCAM_MEDIAMTX_API_PUSH=0

# --- CORS (comma-separated origins, or *) ---
# SMARTCAM_CORS_ORIGINS=*

# --- Discovery (Add Camera in UI = Pi edge mDNS only) ---
# ONVIF credentials for Pi 4 edge agents (same password on every edge camera).
# Quote the password if it contains $ # : @ :
# SMARTCAM_EDGE_ONVIF_USER=admin
# SMARTCAM_EDGE_ONVIF_PASS='your-edge-camera-password'
# SMARTCAM_DISCOVERY=0

# --- Debug / logging (trusted LAN only for secrets in API JSON) ---
# SMARTCAM_DEBUG_FULL_RTSP=1
# SMARTCAM_LOG_STREAM_HEALTH=1
# Block ?include_secrets=1 on GET /cameras/{id}/stream_health (debug panel will not get full RTSP).
# SMARTCAM_DENY_STREAM_HEALTH_SECRETS=1

# --- Detection pipeline (MOG2 → Hailo YOLOv8n → ByteTrack → event confirm) ---
# SMARTCAM_PERSON_DETECT_ENABLED=1
# SMARTCAM_DETECTION_FPS=5
# SMARTCAM_EVENT_CONFIRM_FRAMES=2
# SMARTCAM_PERSON_CONFIDENCE=0.25
# SMARTCAM_ANIMAL_CONFIDENCE=0.20
# SMARTCAM_MOG2_ENABLED=1
# SMARTCAM_MOG2_HEARTBEAT_FRAMES=3
# SMARTCAM_MOG2_MIN_AREA_FRACTION=0.003
# SMARTCAM_MOG2_WARMUP_FRAMES=8
# Legacy aliases:
# SMARTCAM_PERSON_DETECT_INTERVAL_MS=200
# SMARTCAM_PERSON_TRIGGER_MIN_FRAMES=2
# SMARTCAM_MOTION_BUFFER_SECONDS=30
# SMARTCAM_MOTION_CLIP_COOLDOWN_SECONDS=5
# SMARTCAM_MOTION_PERSON_GAP_SECONDS=2.5
# SMARTCAM_PERSON_MIN_BOX_FRACTION=0.0005
# OpenCV SSD fallback (when Hailo unavailable):
# SMARTCAM_MODEL_DIR=controller/backend/models
# SMARTCAM_SSD_PROTO=
# SMARTCAM_SSD_WEIGHTS=
# Hailo YOLOv8n (Pi 5 AI HAT — primary detector):
# SMARTCAM_HAILO_HEF_PATH=models/yolov8n.hef
# SMARTCAM_HAILO_INPUT_SIZE=640
# SMARTCAM_HAILO_WHEEL=/path/to/hailo_platform-*-cp313-*-linux_aarch64.whl
# SMARTCAM_INSTALL_HAILO=0
# SMARTCAM_AUTO_APT=0

# --- OpenCV RTSP read tuning (optional) ---
# SURVEILLANCE_OPENCV_FFMPEG_CAPTURE_OPTIONS=...

# --- Hailo YOLO (Pi 5 AI HAT — optional; not on PyPI) ---
# start.sh runs scripts/install_hailo_platform.sh when import fails (needs wheel or hailo-all).
# Copy hailo_platform-*.whl to backend/wheels/ or set:
# SMARTCAM_HAILO_WHEEL=/path/to/hailo_platform-*-cp313-*-linux_aarch64.whl
# SMARTCAM_HAILO_HEF_PATH=models/yolov8n.hef
# SMARTCAM_FACE_BACKEND=hailo_person_face
# SMARTCAM_INSTALL_HAILO=0
# SMARTCAM_AUTO_APT=0

SMARTCAM_PERSON_CONFIDENCE=0.25
SMARTCAM_ANIMAL_CONFIDENCE=0.20
SMARTCAM_DETECTION_FPS=5
SMARTCAM_EVENT_CONFIRM_FRAMES=2
SMARTCAM_HAILO_HEF_PATH=models/yolov8n.hef
