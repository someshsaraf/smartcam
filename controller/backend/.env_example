# Copy to `.env` or export before starting the controller API.
# Do not commit real secrets.

# --- MQTT bridge (subscribe on Pi 5; edge agents publish here) ---
# Unset HOST = bridge does not connect (see /system/recording mqtt_host_configured).
CONTROLLER_MQTT_HOST=
CONTROLLER_MQTT_PORT=1883
CONTROLLER_MQTT_USER=
CONTROLLER_MQTT_PASSWORD=
CONTROLLER_MQTT_TOPIC_PREFIX=surveillance/cameras

# --- Detector models (MobileNet-SSD via surveillance_shared) ---
# If unset, code defaults to: <controller/backend>/models (see app/detector.py setdefault).
# SURVEILLANCE_MODEL_DIR=

# --- OpenCV RTSP (optional global override before cv2 import on controller paths) ---
# OPENCV_FFMPEG_CAPTURE_OPTIONS=

# --- Embedded MediaMTX (controller pulls camera RTSP; browser uses WebRTC + HLS) ---
# Install binary: ./scripts/install_mediamtx.sh → backend/bin/mediamtx
# CONTROLLER_MEDIAMTX_DISABLED=1
# CONTROLLER_MEDIAMTX_BIN=
# CONTROLLER_MEDIAMTX_WEBRTC_ADDRESS=:8889
# Low-latency HLS for dashboard <video> + face overlay (frontend VITE_HLS_BASE → this port)
# CONTROLLER_MEDIAMTX_HLS_ADDRESS=:8888
# CONTROLLER_MEDIAMTX_HLS_DISABLED=1

# --- Phase 1: live face detection → WebSocket /ws/detections ---
# SMARTCAM_LIVE_DETECTION_DISABLED=1
# opencv = Haar cascade (default). hailo = stub until integrated (falls back to OpenCV).
# SMARTCAM_FACE_BACKEND=opencv
# SMARTCAM_FACE_DETECT_INTERVAL_FRAMES=5
# SMARTCAM_FACE_WS_MIN_INTERVAL_SEC=0.12
# SMARTCAM_LIVE_DETECTION_MAX_CAMERAS=6
# SMARTCAM_FACE_HAAR_SCALE=1.05
# SMARTCAM_FACE_HAAR_MIN_NEIGHBORS=4
# When MediaMTX runs, workers read rtsp://HOST:PORT/<mediamtx_path> (default 127.0.0.1:8554)
# CONTROLLER_INFERENCE_RTSP_HOST=127.0.0.1
# CONTROLLER_INFERENCE_RTSP_PORT=8554
