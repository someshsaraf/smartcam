# Copy to `.env` or export before starting the controller API.
# Do not commit real secrets.

# --- MQTT bridge (subscribe on Pi 5; edge agents publish here) ---
# Unset HOST = bridge does not connect (see /system/recording mqtt_host_configured).
CONTROLLER_MQTT_HOST=
CONTROLLER_MQTT_PORT=1883
CONTROLLER_MQTT_USER=
CONTROLLER_MQTT_PASSWORD=
CONTROLLER_MQTT_TOPIC_PREFIX=surveillance/cameras

# --- Detector models (MobileNet-SSD via surveillance_shared) ---
# If unset, code defaults to: <controller/backend>/models (see app/detector.py setdefault).
# SURVEILLANCE_MODEL_DIR=

# --- OpenCV RTSP (optional global override before cv2 import on controller paths) ---
# OPENCV_FFMPEG_CAPTURE_OPTIONS=
